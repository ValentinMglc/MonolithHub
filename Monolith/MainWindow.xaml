<Window x:Class="Monolith.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Monolith.Controls"
        Title="Monolith" Icon="pack://application:,,,/Monolith;component/app.ico" Width="1280" Height="840" MinWidth="1040" MinHeight="660"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="Root">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- ══════════════════ Barre latérale ══════════════════ -->
            <DockPanel Background="{StaticResource SidebarBrush}">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,18,0,28">
                    <Image Source="pack://application:,,,/Monolith;component/app.ico" Width="30" Height="30"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Monolith" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="ModelText" Text="Obelisk" Style="{StaticResource Caption}" FontWeight="Normal"/>
                    </StackPanel>
                </StackPanel>

                <!-- Résumé en direct, visible depuis toutes les pages -->
                <Border DockPanel.Dock="Bottom" Margin="14,0,14,16" Padding="14,12" CornerRadius="10"
                        Background="{StaticResource CardBrush}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock x:Name="MiniCpuText" DockPanel.Dock="Right" Style="{StaticResource SubtleText}"/>
                            <TextBlock Text="CPU" Style="{StaticResource Caption}"/>
                        </DockPanel>
                        <ProgressBar x:Name="MiniCpuBar" Height="4" Margin="0,0,0,10"/>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock x:Name="MiniGpuText" DockPanel.Dock="Right" Style="{StaticResource SubtleText}"/>
                            <TextBlock Text="GPU" Style="{StaticResource Caption}"/>
                        </DockPanel>
                        <ProgressBar x:Name="MiniGpuBar" Height="4" Margin="0,0,0,10"/>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock x:Name="MiniRamText" DockPanel.Dock="Right" Style="{StaticResource SubtleText}"/>
                            <TextBlock Text="RAM" Style="{StaticResource Caption}"/>
                        </DockPanel>
                        <ProgressBar x:Name="MiniRamBar" Height="4" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LightingDot" Width="7" Height="7" Fill="{StaticResource FaintTextBrush}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="LightingDotText" Text="Éclairage…" Style="{StaticResource SubtleText}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButton}" Content="Tableau de bord" Tag="&#xE80F;"
                                 IsChecked="True" Checked="OnNavigate" CommandParameter="DashboardPage"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Capteurs" Tag="&#xE9D9;"
                                 Checked="OnNavigate" CommandParameter="SensorsPage"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Éclairage" Tag="&#xEA80;"
                                 Checked="OnNavigate" CommandParameter="LightingPage"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Système" Tag="&#xE946;"
                                 Checked="OnNavigate" CommandParameter="SystemPage"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Paramètres" Tag="&#xE713;"
                                 Checked="OnNavigate" CommandParameter="SettingsPage"/>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <!-- ══════════════════ Barre de titre ══════════════════ -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource CaptionButton}" Click="OnMinimize"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Réduire">
                        <TextBlock Text="&#xE921;" Style="{StaticResource Icon}" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="OnMaximize"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Agrandir">
                        <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" Style="{StaticResource Icon}" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Click="OnClose"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Fermer">
                        <TextBlock Text="&#xE8BB;" Style="{StaticResource Icon}" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>

                <Grid x:Name="PageHost" Grid.Row="1">
                    <!-- ══════════════════ Tableau de bord ══════════════════ -->
                    <ScrollViewer x:Name="DashboardPage" Padding="24,0,24,20">
                        <StackPanel>
                            <DockPanel Margin="6,0,6,14">
                                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="{StaticResource GoodBrush}" Margin="0,0,7,0"/>
                                        <TextBlock x:Name="LiveText" Text="En direct" Style="{StaticResource SubtleText}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Tableau de bord" Style="{StaticResource PageTitle}"/>
                            </DockPanel>

                            <Border x:Name="DriverBanner" Style="{StaticResource Card}" Visibility="Collapsed"
                                    Background="#1FFFB020" BorderBrush="#55FFB020" Padding="14,10">
                                <DockPanel>
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource WarnBrush}"
                                               Margin="0,0,12,0"/>
                                    <Button x:Name="DriverBannerButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                            Click="OnDriverAction" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="DriverBannerTitle" Text="Température CPU indisponible" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="DriverBannerText" Style="{StaticResource SubtleText}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <UniformGrid Columns="3">
                                <!-- CPU -->
                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Bottom">
                                            <TextBlock Text="UTILISATION · 60 S" Style="{StaticResource Caption}" Margin="0,16,0,4"/>
                                            <c:Sparkline x:Name="CpuSpark" Height="42" Stroke="{StaticResource AccentBrush}" Fill="{StaticResource SparkFillBrush}"/>
                                        </StackPanel>
                                        <StackPanel>
                                        <DockPanel Margin="0,0,0,14">
                                            <TextBlock Text="&#xE950;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                                            <TextBlock x:Name="CpuNameText" DockPanel.Dock="Right" Style="{StaticResource Caption}"
                                                       FontWeight="Normal" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                            <TextBlock Text="Processeur" Style="{StaticResource CardTitle}"/>
                                        </DockPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="108" Height="108">
                                                <c:RingGauge x:Name="CpuGauge" Thickness="8" TrackBrush="{StaticResource TrackBrush}"
                                                             FillBrush="{StaticResource GaugeBrush}"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="CpuLoadText" Text="—" Style="{StaticResource BigValue}" FontSize="26" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="utilisation" Style="{StaticResource Caption}" FontWeight="Normal" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="18,4,0,0">
                                                <TextBlock x:Name="CpuTempText" Text="—" Style="{StaticResource BigValue}"/>
                                                <TextBlock Text="TEMPÉRATURE" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                                                <DockPanel Margin="0,0,0,3">
                                                    <TextBlock x:Name="CpuClockText" DockPanel.Dock="Right" Text="—"/>
                                                    <TextBlock Text="Fréquence" Style="{StaticResource SubtleText}"/>
                                                </DockPanel>
                                                <DockPanel>
                                                    <TextBlock x:Name="CpuPowerText" DockPanel.Dock="Right" Text="—"/>
                                                    <TextBlock Text="Puissance" Style="{StaticResource SubtleText}"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                    </DockPanel>
                                </Border>
                                <!-- GPU -->
                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Bottom">
                                            <TextBlock Text="UTILISATION · 60 S" Style="{StaticResource Caption}" Margin="0,16,0,4"/>
                                            <c:Sparkline x:Name="GpuSpark" Height="42" Stroke="{StaticResource AccentBrush}" Fill="{StaticResource SparkFillBrush}"/>
                                        </StackPanel>
                                        <StackPanel>
                                        <DockPanel Margin="0,0,0,14">
                                            <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                                            <TextBlock x:Name="GpuNameText" DockPanel.Dock="Right" Style="{StaticResource Caption}"
                                                       FontWeight="Normal" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                            <TextBlock Text="Carte graphique" Style="{StaticResource CardTitle}"/>
                                        </DockPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="108" Height="108">
                                                <c:RingGauge x:Name="GpuGauge" Thickness="8" TrackBrush="{StaticResource TrackBrush}"
                                                             FillBrush="{StaticResource GaugeBrush}"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="GpuLoadText" Text="—" Style="{StaticResource BigValue}" FontSize="26" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="utilisation" Style="{StaticResource Caption}" FontWeight="Normal" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="18,4,0,0">
                                                <TextBlock x:Name="GpuTempText" Text="—" Style="{StaticResource BigValue}"/>
                                                <TextBlock Text="TEMPÉRATURE" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                                                <DockPanel Margin="0,0,0,3">
                                                    <TextBlock x:Name="GpuVramText" DockPanel.Dock="Right" Text="—"/>
                                                    <TextBlock Text="VRAM" Style="{StaticResource SubtleText}"/>
                                                </DockPanel>
                                                <DockPanel Margin="0,0,0,3">
                                                    <TextBlock x:Name="GpuClockText" DockPanel.Dock="Right" Text="—"/>
                                                    <TextBlock Text="Fréquence" Style="{StaticResource SubtleText}"/>
                                                </DockPanel>
                                                <DockPanel>
                                                    <TextBlock x:Name="GpuPowerText" DockPanel.Dock="Right" Text="—"/>
                                                    <TextBlock Text="Puissance" Style="{StaticResource SubtleText}"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                    </DockPanel>
                                </Border>
                                <!-- RAM -->
                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Bottom">
                                            <TextBlock Text="UTILISATION · 60 S" Style="{StaticResource Caption}" Margin="0,16,0,4"/>
                                            <c:Sparkline x:Name="RamSpark" Height="42" Stroke="{StaticResource AccentBrush}" Fill="{StaticResource SparkFillBrush}"/>
                                        </StackPanel>
                                        <StackPanel>
                                        <DockPanel Margin="0,0,0,14">
                                            <TextBlock Text="&#xE9F5;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                                            <TextBlock x:Name="RamTotalText" DockPanel.Dock="Right" Style="{StaticResource Caption}"
                                                       FontWeight="Normal" VerticalAlignment="Center"/>
                                            <TextBlock Text="Mémoire" Style="{StaticResource CardTitle}"/>
                                        </DockPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="108" Height="108">
                                                <c:RingGauge x:Name="RamGauge" Thickness="8" TrackBrush="{StaticResource TrackBrush}"
                                                             FillBrush="{StaticResource GaugeBrush}"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="RamLoadText" Text="—" Style="{StaticResource BigValue}" FontSize="26" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="utilisée" Style="{StaticResource Caption}" FontWeight="Normal" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="18,4,0,0">
                                                <TextBlock x:Name="RamUsedText" Text="—" Style="{StaticResource BigValue}"/>
                                                <TextBlock Text="UTILISÉE" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                                                <DockPanel>
                                                    <TextBlock x:Name="RamFreeText" DockPanel.Dock="Right" Text="—"/>
                                                    <TextBlock Text="Disponible" Style="{StaticResource SubtleText}"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                    </DockPanel>
                                </Border>
                            </UniformGrid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <!-- Réseau -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,14">
                                            <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                                            <TextBlock Text="Réseau" Style="{StaticResource CardTitle}"/>
                                        </DockPanel>
                                        <UniformGrid Columns="2" Margin="0,0,0,12">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource GoodBrush}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="RÉCEPTION" Style="{StaticResource Caption}"/>
                                                </StackPanel>
                                                <TextBlock Margin="0,2,0,0">
                                                    <Run x:Name="DownText" Text="0" FontSize="26" FontWeight="SemiBold"/>
                                                    <Run x:Name="DownUnit" Text="Mb/s" Foreground="{StaticResource SubtleTextBrush}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE898;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource InfoBrush}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="ENVOI" Style="{StaticResource Caption}"/>
                                                </StackPanel>
                                                <TextBlock Margin="0,2,0,0">
                                                    <Run x:Name="UpText" Text="0" FontSize="26" FontWeight="SemiBold"/>
                                                    <Run x:Name="UpUnit" Text="Mb/s" Foreground="{StaticResource SubtleTextBrush}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </UniformGrid>
                                        <Grid Height="70">
                                            <c:Sparkline x:Name="DownSpark" Stroke="{StaticResource GoodBrush}" Fill="{StaticResource SparkFillGreenBrush}"/>
                                            <c:Sparkline x:Name="UpSpark" Stroke="{StaticResource InfoBrush}" Fill="{StaticResource SparkFillBlueBrush}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <!-- Stockage -->
                                <Border Grid.Column="1" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,14">
                                            <TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                                            <TextBlock Text="Stockage" Style="{StaticResource CardTitle}"/>
                                        </DockPanel>
                                        <ItemsControl x:Name="DrivesList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,14">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="38"/>
                                                            <ColumnDefinition/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="30" Height="30" CornerRadius="7" Background="{StaticResource TrackBrush}" VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="11"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource SubtleText}"
                                                                           Text="{Binding Summary, Mode=OneWay}"/>
                                                                <TextBlock Text="{Binding DisplayLabel, Mode=OneWay}" FontWeight="SemiBold"/>
                                                            </DockPanel>
                                                            <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Margin="0,7,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Processus -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="OnOpenTaskManager">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Gestionnaire des tâches" FontSize="12"/>
                                                <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="11" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Text="&#xE8FD;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                                        <TextBlock Text="Processus les plus actifs" Style="{StaticResource CardTitle}"/>
                                    </DockPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="NOM" Style="{StaticResource Caption}"/>
                                        <TextBlock Grid.Column="1" Text="PROCESSEUR" Style="{StaticResource Caption}"/>
                                        <TextBlock Grid.Column="2" Text="MÉMOIRE" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ItemsControl x:Name="ProcessList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition Width="160"/>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="100"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                                                        <ProgressBar Grid.Column="1" Value="{Binding CpuBar, Mode=OneWay}" Height="4"
                                                                     Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding CpuText, Mode=OneWay}" Style="{StaticResource SubtleText}"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding RamText, Mode=OneWay}" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ══════════════════ Capteurs ══════════════════ -->
                    <ScrollViewer x:Name="SensorsPage" Padding="24,0,24,20" Visibility="Collapsed">
                        <StackPanel>
                            <DockPanel Margin="6,0,6,14">
                                <Grid DockPanel.Dock="Right" Width="260">
                                    <TextBox x:Name="SensorSearch" Style="{StaticResource InputBox}" Padding="30,6,8,6"
                                             TextChanged="OnSensorSearchChanged"/>
                                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Margin="11,0,0,0"
                                               HorizontalAlignment="Left" IsHitTestVisible="False"/>
                                    <TextBlock x:Name="SensorSearchHint" Text="Rechercher un capteur…" Style="{StaticResource SubtleText}"
                                               Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>
                                <TextBlock Text="Capteurs" Style="{StaticResource PageTitle}"/>
                            </DockPanel>
                            <ItemsControl x:Name="SensorGroups">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}"
                                                Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding Hardware}" Style="{StaticResource CardTitle}"/>
                                                </DockPanel>
                                                <ItemsControl ItemsSource="{Binding Sections}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,8,0,0"
                                                                        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                                                <Grid Margin="0,0,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition/>
                                                                        <ColumnDefinition Width="100"/>
                                                                        <ColumnDefinition Width="100"/>
                                                                        <ColumnDefinition Width="100"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}"/>
                                                                    <TextBlock Grid.Column="1" Text="ACTUEL" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                                                                    <TextBlock Grid.Column="2" Text="MIN" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                                                                    <TextBlock Grid.Column="3" Text="MAX" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                                                                </Grid>
                                                                <ItemsControl ItemsSource="{Binding Rows}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,5"
                                                                                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition/>
                                                                                        <ColumnDefinition Width="100"/>
                                                                                        <ColumnDefinition Width="100"/>
                                                                                        <ColumnDefinition Width="100"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                                                    <TextBlock Grid.Column="2" Text="{Binding Min}" Style="{StaticResource SubtleText}" HorizontalAlignment="Right"/>
                                                                                    <TextBlock Grid.Column="3" Text="{Binding Max}" Style="{StaticResource SubtleText}" HorizontalAlignment="Right"/>
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="SensorEmpty" Text="Aucun capteur ne correspond à la recherche."
                                       Style="{StaticResource SubtleText}" Margin="8" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ══════════════════ Éclairage ══════════════════ -->
                    <ScrollViewer x:Name="LightingPage" Padding="24,0,24,20" Visibility="Collapsed">
                        <StackPanel>
                            <DockPanel Margin="6,0,6,14">
                                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Padding="12,5">
                                    <CheckBox x:Name="MasterSwitch" Click="OnMasterSwitchClick">
                                        <TextBlock x:Name="MasterSwitchText" Text="Allumé" FontWeight="SemiBold"/>
                                    </CheckBox>
                                </Border>
                                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="ControllerDot" Width="7" Height="7" Fill="{StaticResource GoodBrush}" Margin="0,0,7,0"/>
                                        <TextBlock x:Name="ControllerText" Text="Contrôleur connecté" Style="{StaticResource SubtleText}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Éclairage" Style="{StaticResource PageTitle}"/>
                            </DockPanel>

                            <!-- PC sans contrôleur compatible -->
                            <Border x:Name="UnsupportedCard" Style="{StaticResource Card}" Visibility="Collapsed" Padding="24,22">
                                <DockPanel>
                                    <TextBlock Text="&#xEA80;" Style="{StaticResource Icon}" FontSize="28" Margin="0,0,18,0" VerticalAlignment="Top"/>
                                    <StackPanel>
                                        <TextBlock Text="Éclairage non pris en charge sur ce PC" Style="{StaticResource CardTitle}" FontSize="16"/>
                                        <TextBlock Style="{StaticResource SubtleText}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Text="Monolith pilote le contrôleur d'éclairage USB des HP OMEN Obelisk 875 (testé) et OMEN 30L (même contrôleur, 103C:84FD). Aucun contrôleur compatible n'a été détecté sur ce PC."/>
                                        <TextBlock Style="{StaticResource SubtleText}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Text="Le monitoring, les alertes et le reste de l'application fonctionnent normalement. Si vous pensez que votre modèle devrait être compatible, ouvrez un ticket sur GitHub en joignant le journal (Paramètres → À propos)."/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <StackPanel x:Name="LightingControls">
                            <!-- Contrôleur présent mais utilisé par une autre application -->
                            <Border x:Name="BusyCard" Style="{StaticResource Card}" Visibility="Collapsed"
                                    Background="#1FFFB020" BorderBrush="#55FFB020" Padding="14,10">
                                <DockPanel>
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource WarnBrush}" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Contrôleur d'éclairage occupé" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap"
                                                   Text="Une autre application l'utilise, probablement l'OMEN Gaming Hub. Fermez-la : Monolith se reconnectera automatiquement."/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Profils -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <Button x:Name="SaveProfileButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                                Click="OnSaveProfileClick" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                <TextBlock Text="Enregistrer le réglage actuel" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Text="&#xE734;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Profils" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Style="{StaticResource SubtleText}" Margin="0,2,0,0"
                                                       Text="Un clic pour appliquer, Ctrl+Alt+1 à 9 depuis n'importe où. Clic droit pour modifier ou supprimer."/>
                                        </StackPanel>
                                    </DockPanel>
                                    <WrapPanel x:Name="ProfilesPanel"/>
                                    <DockPanel x:Name="ProfileNameEditor" Visibility="Collapsed" Margin="0,8,0,0">
                                        <Button DockPanel.Dock="Right" Content="Annuler" Style="{StaticResource GhostButton}"
                                                Margin="8,0,0,0" Click="OnCancelProfileClick"/>
                                        <Button DockPanel.Dock="Right" Content="Enregistrer" Style="{StaticResource PrimaryButton}"
                                                Margin="8,0,0,0" Click="OnConfirmProfileClick"/>
                                        <Grid>
                                            <TextBox x:Name="ProfileNameBox" Style="{StaticResource InputBox}" MaxLength="24"
                                                     KeyDown="OnProfileNameKeyDown" TextChanged="OnProfileNameChanged"/>
                                            <TextBlock x:Name="ProfileNameHint" Text="Nom du profil (ex. Streaming)" Style="{StaticResource SubtleText}"
                                                       Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        </Grid>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Grid x:Name="LightingBody">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="6*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Aperçu du boîtier -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Cliquez sur une zone pour la régler" Style="{StaticResource SubtleText}"
                                                   HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                        <Viewbox Height="300" Stretch="Uniform">
                                            <Canvas Width="400" Height="345">
                                                <!-- Façade -->
                                                <Grid x:Name="LogoHit" Canvas.Left="20" Canvas.Top="10" Width="130" Height="300"
                                                      Background="Transparent" Cursor="Hand" MouseLeftButtonUp="OnLogoZoneClick">
                                                    <Border x:Name="LogoSelection" CornerRadius="10" BorderThickness="2" Margin="-8"
                                                            BorderBrush="{StaticResource AccentBrush}" Opacity="0"/>
                                                    <Path Data="M 0,0 L 130,0 L 130,300 L 0,300 Z" Fill="#1C1D22" Stroke="#3A3B44" StrokeThickness="1.5"/>
                                                    <Path Data="M 0,0 L 65,62 L 130,0 M 65,62 L 65,240 M 0,300 L 65,240 L 130,300" Stroke="#2C2D35" StrokeThickness="1.5"/>
                                                    <Path x:Name="LogoGlyph" Data="M 65,14 L 89,38 L 65,62 L 41,38 Z" Fill="Red">
                                                        <Path.Effect>
                                                            <DropShadowEffect x:Name="LogoGlow" ShadowDepth="0" BlurRadius="28" Color="Red" Opacity="1"/>
                                                        </Path.Effect>
                                                    </Path>
                                                    <Path Data="M 65,26 L 77,38 L 65,50 L 53,38 Z" Fill="#14151A" Opacity="0.55"/>
                                                </Grid>
                                                <TextBlock Canvas.Left="20" Canvas.Top="326" Width="130" TextAlignment="Center"
                                                           Text="Logo (façade)" Style="{StaticResource SubtleText}"/>

                                                <!-- Côté vitré -->
                                                <Grid x:Name="BarHit" Canvas.Left="175" Canvas.Top="10" Width="205" Height="300"
                                                      Background="Transparent" Cursor="Hand" MouseLeftButtonUp="OnBarZoneClick">
                                                    <Border x:Name="BarSelection" CornerRadius="10" BorderThickness="2" Margin="-8"
                                                            BorderBrush="{StaticResource AccentBrush}" Opacity="0"/>
                                                    <Border CornerRadius="4" Background="#1C1D22" BorderBrush="#3A3B44" BorderThickness="1.5"/>
                                                    <Border x:Name="BarWindow" Margin="14" CornerRadius="3" BorderBrush="#2C2D35" BorderThickness="1.5">
                                                        <Border.Background>
                                                            <LinearGradientBrush x:Name="BarAmbient" StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop x:Name="BarAmbientTop" Color="#40FF0000" Offset="0"/>
                                                                <GradientStop Color="#0012131A" Offset="0.7"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <Rectangle x:Name="BarGlyph" Height="6" RadiusX="3" RadiusY="3" Margin="26,24,26,0"
                                                               VerticalAlignment="Top" Fill="Red">
                                                        <Rectangle.Effect>
                                                            <DropShadowEffect x:Name="BarGlow" ShadowDepth="0" BlurRadius="24" Color="Red" Opacity="1"/>
                                                        </Rectangle.Effect>
                                                    </Rectangle>
                                                </Grid>
                                                <TextBlock Canvas.Left="175" Canvas.Top="326" Width="205" TextAlignment="Center"
                                                           Text="Barre lumineuse (intérieur)" Style="{StaticResource SubtleText}"/>
                                            </Canvas>
                                        </Viewbox>

                                        <Border Background="{StaticResource TrackBrush}" CornerRadius="9" Margin="0,16,0,0">
                                            <UniformGrid Columns="3">
                                                <RadioButton x:Name="TargetBoth" Style="{StaticResource TabSegment}" GroupName="Target"
                                                             Content="Les deux" Checked="OnTargetChecked" Tag="Both"/>
                                                <RadioButton x:Name="TargetLogo" Style="{StaticResource TabSegment}" GroupName="Target"
                                                             Content="Logo" Checked="OnTargetChecked" Tag="Logo"/>
                                                <RadioButton x:Name="TargetBar" Style="{StaticResource TabSegment}" GroupName="Target"
                                                             Content="Barre intérieure" Checked="OnTargetChecked" Tag="Bar"/>
                                            </UniformGrid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Réglages -->
                                <Border x:Name="EditorCard" Grid.Column="1" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock x:Name="EditorTitle" Text="Les deux zones" Style="{StaticResource CardTitle}"/>
                                        <TextBlock x:Name="EditorSubtitle" Style="{StaticResource SubtleText}" Margin="0,2,0,16" TextWrapping="Wrap"/>
                                        <c:ZoneEditor x:Name="Editor"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Couleur selon la température -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel>
                                        <CheckBox x:Name="ReactiveSwitch" DockPanel.Dock="Right" VerticalAlignment="Center" Click="OnReactiveSwitchClick"/>
                                        <TextBlock Text="&#xE9CA;" Style="{StaticResource Icon}" Margin="0,0,12,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Couleur selon la température" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Style="{StaticResource SubtleText}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                       Text="L'éclairage glisse de la couleur « froid » à la couleur « chaud » quand le PC chauffe. Remplace l'effet choisi pour les zones concernées."/>
                                        </StackPanel>
                                    </DockPanel>

                                    <StackPanel x:Name="ReactiveBody" Margin="0,18,0,0">
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="TEMPÉRATURE SUIVIE" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                                                <WrapPanel x:Name="ReactiveSourcePanel">
                                                    <RadioButton Content="Le plus chaud" Tag="Hottest" GroupName="ReactiveSource"
                                                                 Style="{StaticResource SegmentButton}" Checked="OnReactiveOptionChecked"/>
                                                    <RadioButton Content="Processeur" Tag="Cpu" GroupName="ReactiveSource"
                                                                 Style="{StaticResource SegmentButton}" Checked="OnReactiveOptionChecked"/>
                                                    <RadioButton Content="Carte graphique" Tag="Gpu" GroupName="ReactiveSource"
                                                                 Style="{StaticResource SegmentButton}" Checked="OnReactiveOptionChecked"/>
                                                </WrapPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                                <TextBlock Text="ZONES" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                                                <WrapPanel x:Name="ReactiveZonesPanel">
                                                    <RadioButton Content="Logo" Tag="Logo" GroupName="ReactiveZones"
                                                                 Style="{StaticResource SegmentButton}" Checked="OnReactiveOptionChecked"/>
                                                    <RadioButton Content="Barre intérieure" Tag="LightBar" GroupName="ReactiveZones"
                                                                 Style="{StaticResource SegmentButton}" Checked="OnReactiveOptionChecked"/>
                                                    <RadioButton Content="Les deux" Tag="Both" GroupName="ReactiveZones"
                                                                 Style="{StaticResource SegmentButton}" Checked="OnReactiveOptionChecked"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Dégradé avec la position de la température actuelle -->
                                        <Grid Height="16" Margin="0,0,0,6">
                                            <Border CornerRadius="8">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop x:Name="ReactiveColdStop" Color="#0080FF" Offset="0"/>
                                                        <GradientStop x:Name="ReactiveHotStop" Color="#FF0000" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Canvas x:Name="ReactiveTrack">
                                                <Ellipse x:Name="ReactiveMarker" Width="22" Height="22" Canvas.Top="-3" Fill="White"
                                                         Stroke="#0E0F12" StrokeThickness="4" Visibility="Collapsed"/>
                                            </Canvas>
                                        </Grid>
                                        <DockPanel Margin="0,0,0,18">
                                            <TextBlock x:Name="ReactiveHotLabel" DockPanel.Dock="Right" Style="{StaticResource SubtleText}"/>
                                            <TextBlock x:Name="ReactiveColdLabel" DockPanel.Dock="Left" Style="{StaticResource SubtleText}"/>
                                            <TextBlock x:Name="ReactiveNowText" TextAlignment="Center" FontWeight="SemiBold"/>
                                        </DockPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <TextBlock x:Name="ColdTempText" DockPanel.Dock="Right" FontWeight="SemiBold"/>
                                                    <TextBlock Text="FROID — COULEUR EN DESSOUS DE" Style="{StaticResource Caption}"/>
                                                </DockPanel>
                                                <Slider x:Name="ColdTempSlider" Minimum="20" Maximum="80" SmallChange="1" LargeChange="5"
                                                        IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,0,10"
                                                        ValueChanged="OnReactiveTempChanged"/>
                                                <c:ColorSwatches x:Name="ColdPicker"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="24,0,0,0">
                                                <DockPanel Margin="0,0,0,8">
                                                    <TextBlock x:Name="HotTempText" DockPanel.Dock="Right" FontWeight="SemiBold"/>
                                                    <TextBlock Text="CHAUD — COULEUR AU-DESSUS DE" Style="{StaticResource Caption}"/>
                                                </DockPanel>
                                                <Slider x:Name="HotTempSlider" Minimum="40" Maximum="100" SmallChange="1" LargeChange="5"
                                                        IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,0,10"
                                                        ValueChanged="OnReactiveTempChanged"/>
                                                <c:ColorSwatches x:Name="HotPicker"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ══════════════════ Paramètres ══════════════════ -->
                    <ScrollViewer x:Name="SettingsPage" Padding="24,0,24,20" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Paramètres" Style="{StaticResource PageTitle}" Margin="6,0,6,14"/>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Démarrage et arrière-plan" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                                    <DockPanel Margin="0,6">
                                        <CheckBox x:Name="StartupCheck" DockPanel.Dock="Right" VerticalAlignment="Center" Click="OnStartupClick"/>
                                        <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" Margin="0,0,14,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Démarrer avec Windows" FontWeight="SemiBold"/>
                                            <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                       Text="Monolith se lance discrètement près de l'horloge et applique votre éclairage."/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,8"/>
                                    <DockPanel Margin="0,6">
                                        <CheckBox x:Name="CloseToTrayCheck" DockPanel.Dock="Right" VerticalAlignment="Center" Click="OnCloseToTrayClick"/>
                                        <TextBlock Text="&#xE73F;" Style="{StaticResource Icon}" Margin="0,0,14,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Rester actif en arrière-plan à la fermeture" FontWeight="SemiBold"/>
                                            <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                       Text="La croix range Monolith près de l'horloge : l'éclairage selon la température et les alertes continuent. Pour quitter : clic droit sur l'icône → Quitter."/>
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <CheckBox x:Name="HeatAlertsCheck" DockPanel.Dock="Right" VerticalAlignment="Center" Click="OnHeatAlertsClick"/>
                                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Margin="0,0,14,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Alertes de chauffe" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                       Text="Une notification Windows quand une température dépasse son seuil (une seule fois, jusqu'à ce qu'elle redescende de 5 °C)."/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid x:Name="HeatAlertsBody" Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock x:Name="CpuThresholdText" DockPanel.Dock="Right" FontWeight="SemiBold"/>
                                                <TextBlock Text="SEUIL PROCESSEUR" Style="{StaticResource Caption}"/>
                                            </DockPanel>
                                            <Slider x:Name="CpuThresholdSlider" Minimum="60" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1"
                                                    ValueChanged="OnThresholdChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="24,0,0,0">
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock x:Name="GpuThresholdText" DockPanel.Dock="Right" FontWeight="SemiBold"/>
                                                <TextBlock Text="SEUIL CARTE GRAPHIQUE" Style="{StaticResource Caption}"/>
                                            </DockPanel>
                                            <Slider x:Name="GpuThresholdSlider" Minimum="60" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1"
                                                    ValueChanged="OnThresholdChanged"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Tester" Style="{StaticResource GhostButton}" Margin="24,0,0,0"
                                                VerticalAlignment="Bottom" Click="OnTestAlertClick"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <Button x:Name="PawnButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                            Click="OnDriverAction" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE950;" Style="{StaticResource Icon}" Margin="0,0,14,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Pilote PawnIO (température CPU)" FontWeight="SemiBold"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Ellipse x:Name="PawnDot" Width="7" Height="7" Margin="0,0,8,0" Fill="{StaticResource FaintTextBrush}"/>
                                            <TextBlock x:Name="PawnStatusText" Style="{StaticResource SubtleText}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="&#xE765;" Style="{StaticResource Icon}" Margin="0,0,14,0"/>
                                        <TextBlock Text="Raccourcis clavier" Style="{StaticResource CardTitle}"/>
                                    </DockPanel>
                                    <ItemsControl x:Name="HotkeyList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,7">
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Left" Style="{StaticResource Chip}" Margin="0,0,14,0" MinWidth="86">
                                                            <TextBlock Text="{Binding Keys}" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Description}" VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- À propos -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,14">
                                        <Image Source="pack://application:,,,/Monolith;component/app.ico" Width="40" Height="40"
                                               Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource CardTitle}" FontSize="16">
                                                <Run Text="Monolith"/>
                                                <Run x:Name="VersionRun" Foreground="{StaticResource SubtleTextBrush}" FontWeight="Normal"/>
                                            </TextBlock>
                                            <TextBlock Text="Monitoring et éclairage pour PC HP OMEN. Logiciel libre sous licence MIT."
                                                       Style="{StaticResource SubtleText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <WrapPanel Margin="0,0,0,14">
                                        <Button Style="{StaticResource GhostButton}" Margin="0,0,8,8" Click="OnOpenRepository">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                <TextBlock Text="Page GitHub" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" Margin="0,0,8,8" Click="OnOpenLogs">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                <TextBlock Text="Ouvrir le journal" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" Margin="0,0,8,8" Click="OnCleanupClick">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                <TextBlock Text="Retirer Monolith de Windows…" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>

                                    <TextBlock Text="CRÉDITS" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                    <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" LineHeight="19">
                                        <Run Text="Capteurs : LibreHardwareMonitor (MPL-2.0). Accès USB : HidSharp (Apache-2.0)."/>
                                        <LineBreak/>
                                        <Run Text="Protocole du contrôleur d'éclairage documenté par le projet OpenRGB. Pilote CPU optionnel : PawnIO."/>
                                    </TextBlock>

                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14"/>
                                    <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap"
                                               Text="HP et OMEN sont des marques de HP Inc. Monolith est un projet communautaire indépendant, non affilié à HP Inc., ni approuvé ou soutenu par HP Inc. Les noms de produits servent uniquement à indiquer la compatibilité."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ══════════════════ Système ══════════════════ -->
                    <ScrollViewer x:Name="SystemPage" Padding="24,0,24,20" Visibility="Collapsed">
                        <StackPanel>
                            <DockPanel Margin="6,0,6,14">
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="OnCopySystemInfo" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                        <TextBlock Text="Copier tout" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="Système" Style="{StaticResource PageTitle}"/>
                            </DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <ItemsControl x:Name="SystemLeft" ItemTemplate="{DynamicResource InfoSectionTemplate}"/>
                                <ItemsControl x:Name="SystemRight" Grid.Column="1" ItemTemplate="{DynamicResource InfoSectionTemplate}"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Notification éphémère -->
                <Border x:Name="Toast" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24"
                        Padding="16,10" CornerRadius="10" Background="#2A2B33" BorderBrush="#3A3B44" BorderThickness="1"
                        Opacity="0" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="4" BlurRadius="18" Opacity="0.5"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource GoodBrush}" Margin="0,0,10,0"/>
                        <TextBlock x:Name="ToastText"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>

    <Window.Resources>
        <DataTemplate x:Key="InfoSectionTemplate">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="0"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource SubtleText}" Margin="0,0,16,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextAlignment="Right" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
</Window>
